# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp_db
DB_USER=admin
DB_PASS="s3cr3t=value=with=equals"

# App settings
APP_NAME='My Application'
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

# Variable interpolation
DB_CONNECTION_STRING=postgres://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Inline comments
SECRET_KEY=abcdef123456  # this is a secret key
QUOTED_WITH_COMMENT="hello world"  # this should keep the quoted value

# Edge cases
EMPTY_VALUE=
NO_QUOTES=simple value here
SPACES_AROUND  =  spaces trimmed
export EXPORTED_VAR=i_was_exported

# Multipart
MULTI_EQUALS=a=b=c=d
